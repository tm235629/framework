{
  "name": "kb-dashboard-slice",
  "version": "1.0.0",
  "description": "Framework dashboard slice — a parameterized (KB_ROOT-driven) copy of the reference operations dashboard. Reads the shipped kb-* data layer; instances supply plugin extractors for Sync/To-dos/Events.",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"node server.js\" \"vite\"",
    "server": "node server.js",
    "client": "vite",
    "build": "vite build",
    "config": "node ../tooling/kb-dashboard-config.mjs"
  },
  "keywords": ["dashboard", "framework", "knowledge-base"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0"
  }
}
